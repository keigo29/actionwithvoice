# cp .env.example .env して書く。.env はコミットしない（合言葉が入るので）

# n8n を開く住所（Cloudflare Tunnel の Public Hostname と同じにする）
N8N_HOST=n8n.example.com

# 資格情報を暗号化する鍵。一度決めたら変えない（変えると保存した資格情報が読めなくなる）
# 作り方：openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Cloudflare Tunnel のトークン（Zero Trust → Networks → Tunnels → 作ったトンネル → Docker の欄の --token のあと）
TUNNEL_TOKEN=
